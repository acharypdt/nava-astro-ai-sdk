# NavaAstro Platform — Environment Variables

## Edition
NEXT_PUBLIC_EDITION=community          # community | enterprise

## Google Gemini AI (optional, for enhanced AI reports)
NEXT_PUBLIC_GEMINI_API_KEY=

## Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

## Secrets (stored in Cloudflare KV: PLATFORM_SECRETS)
# JWT_SECRET=                           # JWT signing secret
# ENCRYPTION_KEY=                       # AES-256 encryption key for user data

## Razorpay (enterprise only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

## Tiers (rate limits per hour)
COMMUNITY_RATE_LIMIT=100
PRO_RATE_LIMIT=1000
ENTERPRISE_RATE_LIMIT=10000
