{
  "name": "nava-astro-platform",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./out"
  },
  "kv_namespaces": [
    {
      "binding": "PLATFORM_SECRETS",
      "id": "b5d1d07aea674c2ea44be85731701215"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nava_astro_db",
      "database_id": "b7d7b7d7-b7d7-b7d7-b7d7-b7d7b7d7b7d7"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ai_search": [
    {
      "binding": "AI_SEARCH",
      "id": "c1f7a8b9-c2d3-4e5f-a6b7-c8d9e0f1a2b3"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
